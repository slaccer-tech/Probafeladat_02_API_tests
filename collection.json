{
  "info": {
    "name": "ReqRes API Tests",
    "description": "Automatizált tesztek a https://reqres.in/api/users végponthoz.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /api/users - page 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://reqres.in/api/users?page=1",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "users"],
          "query": [
            {
              "key": "page",
              "value": "1"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
                      "/*",
                      " * ReqRes API - Automated Tests",
                      " * Endpoint: GET /api/users?page=1",
                      " */",
                      "",
                      "// ========================================",
                      "// 1. HTTP VALASZ ES TELJESITMENY",
                      "// ========================================",
                      "",
                      "pm.test(\"TC01 - Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"TC02 - Response time is below 3000 ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "pm.test(\"TC03 - Content-Type is JSON\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                      "        .to.include(\"application/json\");",
                      "});",
                      "",
                      "",
                      "// ========================================",
                      "// 2. JSON STRUKTURA",
                      "// ========================================",
                      "",
                      "let jsonData;",
                      "",
                      "pm.test(\"TC04 - Response body is valid JSON\", function () {",
                      "    jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.be.an(\"object\");",
                      "});",
                      "",
                      "",
                      "// ========================================",
                      "// 3. LAPOZASI MEZOK",
                      "// ========================================",
                      "",
                      "pm.test(\"TC05 - Pagination fields exist\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"page\");",
                      "    pm.expect(jsonData).to.have.property(\"per_page\");",
                      "    pm.expect(jsonData).to.have.property(\"total\");",
                      "    pm.expect(jsonData).to.have.property(\"total_pages\");",
                      "});",
                      "",
                      "pm.test(\"TC06 - Pagination fields are integers\", function () {",
                      "    pm.expect(jsonData.page).to.be.a(\"number\");",
                      "    pm.expect(jsonData.per_page).to.be.a(\"number\");",
                      "    pm.expect(jsonData.total).to.be.a(\"number\");",
                      "    pm.expect(jsonData.total_pages).to.be.a(\"number\");",
                      "",
                      "    pm.expect(Number.isInteger(jsonData.page)).to.be.true;",
                      "    pm.expect(Number.isInteger(jsonData.per_page)).to.be.true;",
                      "    pm.expect(Number.isInteger(jsonData.total)).to.be.true;",
                      "    pm.expect(Number.isInteger(jsonData.total_pages)).to.be.true;",
                      "});",
                      "",
                      "",
                      "// ========================================",
                      "// 4. DATA TOMB STRUKTURAJA",
                      "// ========================================",
                      "",
                      "pm.test(\"TC07 - Data field exists and is an array\", function () {",
                      "    pm.expect(jsonData).to.have.property(\"data\");",
                      "    pm.expect(jsonData.data).to.be.an(\"array\");",
                      "});",
                      "",
                      "pm.test(\"TC08 - Every data element is an object\", function () {",
                      "    jsonData.data.forEach(function (user) {",
                      "        pm.expect(user).to.be.an(\"object\");",
                      "    });",
                      "});",
                      "",
                      "",
                      "// ========================================",
                      "// 5. FELHASZNALO OBJEKTUM STRUKTURAJA",
                      "// ========================================",
                      "",
                      "pm.test(\"TC09 - Every user has expected fields\", function () {",
                      "    jsonData.data.forEach(function (user) {",
                      "        pm.expect(user).to.have.property(\"id\");",
                      "        pm.expect(user).to.have.property(\"email\");",
                      "        pm.expect(user).to.have.property(\"first_name\");",
                      "        pm.expect(user).to.have.property(\"last_name\");",
                      "        pm.expect(user).to.have.property(\"avatar\");",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"TC10 - User fields have correct data types\", function () {",
                      "    jsonData.data.forEach(function (user) {",
                      "        pm.expect(user.id).to.be.a(\"number\");",
                      "        pm.expect(user.email).to.be.a(\"string\");",
                      "        pm.expect(user.first_name).to.be.a(\"string\");",
                      "        pm.expect(user.last_name).to.be.a(\"string\");",
                      "        pm.expect(user.avatar).to.be.a(\"string\");",
                      "    });",
                      "});",
                      "",
                      "",
                      "// ========================================",
                      "// 6. ADATOK HELYESSEGE",
                      "// ========================================",
                      "",
                      "pm.test(\"TC11 - All required fields are filled\", function () {",
                      "    jsonData.data.forEach(function (user) {",
                      "        pm.expect(user.id).to.not.equal(null);",
                      "        pm.expect(user.id).to.not.equal(\"\");",
                      "",
                      "        pm.expect(user.email.trim()).to.not.equal(\"\");",
                      "        pm.expect(user.first_name.trim()).to.not.equal(\"\");",
                      "        pm.expect(user.last_name.trim()).to.not.equal(\"\");",
                      "        pm.expect(user.avatar.trim()).to.not.equal(\"\");",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"TC12 - Email format is valid\", function () {",
                      "    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;",
                      "",
                      "    jsonData.data.forEach(function (user) {",
                      "        pm.expect(user.email).to.match(emailRegex);",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"TC13 - Avatar is a valid URL\", function () {",
                      "    const urlRegex = /^https?:\\/\\/.+/;",
                      "",
                      "    jsonData.data.forEach(function (user) {",
                      "        pm.expect(user.avatar).to.match(urlRegex);",
                      "    });",
                      "});"
                    ]
          }
        }
      ]
    }
  ]
}
